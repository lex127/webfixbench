# Copy to .env and fill in locally. .env is git-ignored; never commit real keys.
# Only the names are listed here — no values, no examples of real credentials.

# Required only for `--provider openai`
OPENAI_API_KEY=

# Required only for `--provider anthropic`
ANTHROPIC_API_KEY=

# Optional: directory containing suites/ and prompts/ (defaults to the checkout)
WEBFIXBENCH_HOME=

# Optional: path to a pricing table used to estimate run cost
# (see config/pricing.sample.json — the benchmark ships no vendor prices)
WEBFIXBENCH_PRICING=
